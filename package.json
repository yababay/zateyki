{
	"name": "zateyki",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"bro": "BROWSER=firefox vite dev --open",
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "./scripts/aws-sync.sh",
		"git:create": "read -p 'Введите имя пути: ' SLUG && git checkout -b $SLUG && mv 'src/routes/(longread)/zyxel-the-cat' 'src/routes/(longread)'/$SLUG",
		"git:local": "read -p 'Суть коммита: ' COMMIT; git add . ; git commit -am $COMMIT",
		"git:remote": "git push origin article",
		"git:update": "./scripts/git-update.sh",
		"git": "npm run git:local && npm run git:remote",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"extract-mdx-metadata": "^2.0.0",
		"mdsvex": "^0.12.6",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"mermaid": "^11.12.2",
		"ol": "^10.7.0"
	}
}
