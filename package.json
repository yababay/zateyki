{
	"name": "zateyki",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"bro": "BROWSER=firefox vite dev --open",
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "./scripts/aws-sync.sh",
		"article:create": "read -p 'Введите имя пути: ' SLUG && git checkout -b $SLUG && mv 'src/routes/(longread)/template' 'src/routes/(longread)'/$SLUG",
		"article:img": "./scripts/optimize-images.sh",
		"article:epub": "./scripts/epub.sh",
		"git:local": "read -p 'Суть коммита: ' COMMIT; git add . ; git commit -am $COMMIT",
		"git:remote": "git push origin template",
		"git:return": "./scripts/git-return.sh",
		"git": "npm run git:local && npm run git:remote"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"hastscript": "^9.0.1",
		"mdsvex": "^0.12.6",
		"rehype-figure": "^1.0.1",
		"rehype-katex-svelte": "^1.2.0",
		"remark-math": "^3.0.0",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"unist-util-visit": "^5.1.0",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"mermaid": "^11.12.2",
		"ol": "^10.7.0",
		"showdown": "^2.1.0"
	}
}
