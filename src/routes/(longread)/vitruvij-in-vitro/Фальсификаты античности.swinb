принадлежность_к_эпохе("Анний", "Возрождение").
принадлежность_к_эпохе("Беросс", "Античность").
принадлежность_к_эпохе("Витрувий", "Античность").
принадлежность_к_эпохе("Витрувий", "Античность").
принадлежность_к_эпохе("Иосиф Флавий", "Античность"). 
принадлежность_к_эпохе("Плиний", "Античность"). 
принадлежность_к_эпохе("Сенека", "Античность"). 
принадлежность_к_эпохе("Павсаний", "Античность"). 
принадлежность_к_эпохе("Автор Описания всего мира и всех народов", "Античность"). 
принадлежность_к_эпохе("Автор Твердыни знаний", "Античность"). 
принадлежность_к_эпохе("Синкелл", "Античность"). 
принадлежность_к_эпохе("Моисей Хоренский", "Античность"). 
