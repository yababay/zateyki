<span class="hljs-comment">% Правила:</span>

не<span class="hljs-symbol">_</span>пересекаются(<span class="hljs-symbol">E1</span>, <span class="hljs-symbol">E2</span>):-
    эпоха(<span class="hljs-symbol">E1</span>),
    эпоха(<span class="hljs-symbol">E2</span>),
    <span class="hljs-symbol">E1</span> \= <span class="hljs-symbol">E2</span>,
    not(пересекаются([<span class="hljs-symbol">E1</span>, <span class="hljs-symbol">E2</span>])),
    not(пересекаются([<span class="hljs-symbol">E2</span>, <span class="hljs-symbol">E1</span>])).

<span class="hljs-comment">% Немного магии для работы со списками:</span>

найти<span class="hljs-symbol">_</span>все(<span class="hljs-symbol">B</span>, <span class="hljs-symbol">L</span>):-
    не<span class="hljs-symbol">_</span>пересекаются(<span class="hljs-symbol">E1</span>, <span class="hljs-symbol">E2</span>),
    format(atom(<span class="hljs-symbol">A</span>), <span class="hljs-string">'Не пересекаются эпохи "~w" и "~w".'</span>, [<span class="hljs-symbol">E1</span>, <span class="hljs-symbol">E2</span>]),
    not(member(<span class="hljs-symbol">A</span>, <span class="hljs-symbol">B</span>)),
    write(<span class="hljs-symbol">A</span>), nl,
    найти<span class="hljs-symbol">_</span>все([<span class="hljs-symbol">A</span>|<span class="hljs-symbol">B</span>], <span class="hljs-symbol">L</span>),!.

найти<span class="hljs-symbol">_</span>все(<span class="hljs-symbol">B</span>, <span class="hljs-symbol">L</span>):-
	<span class="hljs-symbol">L</span> = <span class="hljs-symbol">B</span>,!.

