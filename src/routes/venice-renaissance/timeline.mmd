flowchart TD
    %% Определение стилей для эпох
    classDef early fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#000
    classDef high fill:#fff3e0,stroke:#ef6c00,stroke-width:2px,color:#000
    classDef late fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#000

    %% Маркеры эпох (левая колонка)
    L1(["Раннее Возрождение"]):::early
    L2(["Высокое Возрождение"]):::high
    L3(["Позднее Возрождение"]):::late

    %% Карточки художников (правая колонка)
    A1["<b>Якопо Беллини</b><br/>ок. 1400–1470"]:::early
    A3["<b>Джентиле Беллини</b><br/>1429–1507"]:::early
    A2["<b>Джованни Беллини</b><br/>1430–1516"]:::early
    A5["<b>Джорджоне</b><br/>1477–1510"]:::high
    A6["<b>Тициан</b><br/>1488–1576"]:::high
    A7["<b>Тинторетто</b><br/>1518–1594"]:::late
    A8["<b>Веронезе</b><br/>1528–1588"]:::late
    A9["<b>Пальма Младший</b><br/>1548–1628"]:::late

    %% Основная хронологическая лента
    A1 --> A3 --> A2 --> A5 --> A6 --> A7 --> A8 --> A9

    %% Выстраивание маркеров эпох сверху вниз
    L1 ~~~ L2 ~~~ L3

    %% Привязка маркеров к первому художнику своего периода
    L1 -.- A1
    L2 -.- A5
    L3 -.- A7
